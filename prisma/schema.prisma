generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CLIENTE
  REPOSTERA
}

enum EstadoPedido {
  ORDENADO
  PAGADO
  ENTREGADO
  CANCELADO
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(120)
  telefono String   @db.VarChar(20)
  email    String   @unique @db.VarChar(150)
  password String   @db.VarChar(255)
  rol      Rol      @default(CLIENTE)
  pedidos  Pedido[]

  @@map("usuarios")
}

model PastelCatalogo {
  id                  Int          @id @default(autoincrement())
  nombre              String       @db.VarChar(100)
  permite_relleno     Boolean      @default(true)
  precio_base_porcion Decimal      @db.Decimal(10, 2)
  activo              Boolean      @default(true)
  items               ItemPedido[]

  @@map("pasteles_catalogo")
}

model Relleno {
  id     Int          @id @default(autoincrement())
  nombre String       @db.VarChar(100)
  activo Boolean      @default(true)
  items  ItemPedido[]

  @@map("rellenos")
}

model Pedido {
  id                     Int          @id @default(autoincrement())
  cliente_id             Int
  fecha_creacion         DateTime     @default(now())
  fecha_entrega_esperada DateTime
  estado                 EstadoPedido @default(ORDENADO)
  total_estimado         Decimal      @db.Decimal(10, 2)
  metodo_pago            String       @default("EFECTIVO_FISICO") @db.VarChar(30)
  notas_entrega          String?      @db.Text

  // Campos de auditoría para máquina de estados y reportes
  fecha_pago             DateTime?
  monto_recibido         Decimal?     @db.Decimal(10, 2)
  fecha_entrega_real     DateTime?
  motivo_cancelacion     String?      @db.VarChar(200)
  fecha_cancelacion      DateTime?
  cancelado_por          Rol?

  cliente                Usuario      @relation(fields: [cliente_id], references: [id])
  items                  ItemPedido[]

  @@index([cliente_id])
  @@index([estado])
  @@index([fecha_creacion])
  @@index([fecha_entrega_esperada])
  @@index([fecha_pago])
  @@map("pedidos")
}

model ItemPedido {
  id                 Int                 @id @default(autoincrement())
  pedido_id          Int
  pastel_catalogo_id Int
  relleno_id         Int?
  porciones_totales  Int
  color_primario     String              @db.VarChar(30)
  color_secundario   String              @db.VarChar(30)
  dedicatoria        String?             @db.VarChar(50)
  precio_unitario    Decimal             @db.Decimal(10, 2)

  pedido             Pedido              @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  pastel             PastelCatalogo      @relation(fields: [pastel_catalogo_id], references: [id])
  relleno            Relleno?            @relation(fields: [relleno_id], references: [id])
  distribucion       DistribucionTorta[]

  @@map("items_pedido")
}

model DistribucionTorta {
  id              Int        @id @default(autoincrement())
  item_pedido_id  Int
  porciones_torta Int
  cantidad        Int

  item_pedido     ItemPedido @relation(fields: [item_pedido_id], references: [id], onDelete: Cascade)

  @@map("distribuciones_torta")
}